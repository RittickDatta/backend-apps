    {
      "name": "03 Isolated Dynamic Routing Scenario - RUN IN ORDER",
      "description": "Run in order. First request generates unique test IDs; subsequent requests use them. Test data remains in the in-memory graph until server restart.",
      "item": [
        {
          "name": "Create isolated test intersections (first)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/intersections",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{testA}}\",\n  \"name\": \"Postman Start\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const suffix = Date.now().toString(36) + Math.random().toString(36).slice(2, 7);",
                  "pm.environment.set(\"testA\", \"T\" + suffix + \"A\");",
                  "pm.environment.set(\"testB\", \"T\" + suffix + \"B\");",
                  "pm.environment.set(\"testC\", \"T\" + suffix + \"C\");",
                  "pm.environment.set(\"testRoadAB\", \"P\" + suffix + \"AB\");",
                  "pm.environment.set(\"testRoadBC\", \"P\" + suffix + \"BC\");",
                  "pm.environment.set(\"testRoadAC\", \"P\" + suffix + \"AC\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "(function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.id).to.eql(pm.environment.get(\"testA\"));",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Create test intersection B",
          "request": {
            "method": "POST",
            "header": [
