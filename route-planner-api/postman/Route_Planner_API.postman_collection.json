    {
      "name": "02 Routing - Seeded Graph",
      "description": "",
      "item": [
        {
          "name": "BFS A to C",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/routes/bfs?from=A&to=C"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "(function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.data.path).to.deep.eql([\"A\", \"B\", \"C\"]);",
                  "  pm.expect(body.data.roadCount).to.eql(2);",
                  "})();"
                ]
              }
            }
          ]
        },
        {
          "name": "Dijkstra distance A to C",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/routes/optimal?from=A&to=C&metric=distance"
