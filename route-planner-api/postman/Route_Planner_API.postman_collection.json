                  "  pm.expect(body.data.path).to.deep.eql([pm.environment.get(\"testA\"), pm.environment.get(\"testB\"), pm.environment.get(\"testC\")]);",
                  "  pm.expect(body.data.totalMinutes).to.eql(6);",
                  "})();"
                ]
              }
            }
          ]
        }
